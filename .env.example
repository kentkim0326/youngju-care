# ──────────────────────────────────────────────────
# 영주 돌봄이 (YoungJu Care) 환경 변수 설정
# 이 파일을 복사해 .env 로 저장하고 키를 입력하세요
#   cp .env.example .env
# ──────────────────────────────────────────────────

# 1. 공공데이터포털 API 인증키
#    발급: https://www.data.go.kr → 마이페이지 → 인증키 발급
REACT_APP_PUBLIC_DATA_KEY=YOUR_PUBLIC_DATA_KEY_HERE

# 2. 카카오 REST API 키 (지도/주소변환용)
#    발급: https://developers.kakao.com → 내 애플리케이션 → REST API 키
REACT_APP_KAKAO_REST_KEY=YOUR_KAKAO_REST_KEY_HERE

# 3. KOSIS 통계청 API 키 (독거노인 통계용)
#    발급: https://kosis.kr/openapi
REACT_APP_KOSIS_KEY=YOUR_KOSIS_KEY_HERE
